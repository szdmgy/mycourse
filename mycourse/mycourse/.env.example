# 实验报告收集系统 — 环境变量占位（可选）
# 升级脚本会检查本目录下是否存在 .env；若暂无变量可填写，可复制本文件为 .env：
#   copy .env.example .env

# 管理 API 密钥（作业设置等写接口必填；请改为足够长的随机串）
# MYCOURSE_API_KEY=please-change-me-to-a-long-random-string

# 门户适配（与教师统一门户共享 PORTAL_TOKEN）
PORT=8001
APP_SLUG=mycourse
APP_NAME=实验报告收集系统
REGISTRY_MODE=managed
REGISTRY_URL=http://127.0.0.1:8100
PORTAL_TOKEN=change-me-portal-token
